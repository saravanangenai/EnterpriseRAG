        {
          "name": "Wait until ready",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const v = pm.response.json().versions[0];",
                  "const tries = Number(pm.collectionVariables.get('tries') || 0);",
                  "if (v.status === 'ready') {",
                  "  pm.test('document is ready with chunks', () => pm.expect(v.chunk_count).to.be.above(0));",
                  "} else if (v.status === 'failed') {",
                  "  pm.test('ingestion did not fail', () => pm.expect.fail('failed: ' + v.error));",
                  "} else if (tries < 30) {",
                  "  pm.collectionVariables.set('tries', tries + 1);",
                  "  setTimeout(() => {}, 2000);",
                  "  postman.setNextRequest(pm.info.requestName);",
                  "} else {",
                  "  pm.test('ready within 60 s', () => pm.expect.fail('still ' + v.status));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/documents/{{documentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "documents",
                "{{documentId}}"
              ]
            },
            "description": "Polls itself every 2 s (up to 60 s) until ingestion finishes."
          }
        },

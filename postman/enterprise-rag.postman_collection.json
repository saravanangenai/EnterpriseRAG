    {
      "name": "5. Chat",
      "item": [
        {
          "name": "Ask a question",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('has answer and found flag', () => { pm.expect(j.answer).to.be.a('string').and.not.empty; pm.expect(j.found).to.be.a('boolean'); });",
                  "pm.test('found answers carry citations', () => { if (j.found) pm.expect(j.citations).to.be.an('array').that.is.not.empty; });",
                  "pm.test('citation shape', () => { if (j.found) pm.expect(j.citations[0]).to.include.keys('tag', 'filename', 'page', 'type'); });",
                  "pm.collectionVariables.set('traceId', j.trace_id || '');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/chat",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "chat"
              ]
            },
            "description": "Optional fields: document_id, type (text | table | image).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"How many days do refunds take?\",\n  \"document_id\": \"{{documentId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Rate the answer (needs tracing)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const tid = pm.collectionVariables.get('traceId');",
                  "if (!tid) { pm.test.skip('tracing is off (no trace_id on the answer), nothing to rate'); }",
                  "else { pm.test('204 recorded', () => pm.response.to.have.status(204)); }"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('traceId')) { pm.request.body.update(JSON.stringify({trace_id: '0'.repeat(32), value: 'up'})); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"

      "name": "1. Health",
      "item": [
        {
          "name": "Health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 and ok', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().status).to.eql('ok'); });",
                  "pm.test('providers reported', () => { const j = pm.response.json(); pm.expect(j.llm).to.include(':'); pm.expect(j.embedding).to.include(':'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Shows the active LLM, embedding and vision providers and the Qdrant collection name.",
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
